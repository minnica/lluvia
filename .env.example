# Open-Meteo es el proveedor operativo predeterminado. A5 permite Weatherbit Hourly.
WEATHER_PROVIDER=open-meteo
ROUTING_PROVIDER=tomtom

# Para usar routing y geocodificación de A2 se requiere la clave privada TomTom.
# El mapa usa una clave pública separada, restringida por dominio y producto.
# TOMTOM_API_KEY=
# NEXT_PUBLIC_TOMTOM_MAP_KEY=
# OPEN_METEO_API_KEY=
# OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# OPENWEATHER_API_KEY=
# Requerida solo con WEATHER_PROVIDER=weatherbit; verificar plan y licencia.
# WEATHERBIT_API_KEY=
